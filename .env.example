# Copy to .env. Blank secret fields are intentional; never commit .env.
# Choose demo, api, ollama, or tacc. Course assessment uses MODEL_MODE=tacc.
APP_DATA=data
APP_PUBLIC_URL=http://127.0.0.1:8765
APP_DEMO=1
APP_SECURE_COOKIE=0
MODEL_MODE=demo

# Local inference with the Ollama daemon and a downloaded model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=180
OLLAMA_CONTEXT_LIMIT=16384
OLLAMA_MAX_OUTPUT_TOKENS=1800
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
OLLAMA_EMBEDDING_TIMEOUT=120
# Defaults to enabled in Ollama mode. Uncomment to enable in TACC mode too.
# CONTRACT_VECTOR_SEARCH=1

# Course TACC: set MODEL_MODE=tacc, TACC_PROTOCOL=sdk,
# TACC_MODEL=qwen3.8-27b after authenticating the official SDK.
TACC_PROTOCOL=chat
TACC_URL=
TACC_API_KEY=
TACC_MODEL=
TACC_TIMEOUT=90
TACC_CONTEXT_LIMIT=16384
TACC_JSON_MODE=0
TACC_MAX_OUTPUT_TOKENS=1800
TACC_POLL_URL=
TACC_DISABLE_THINKING=0
TACC_SDK_TIMEOUT=720
# WSL/SSH setup alone can take more than 15 seconds on the course gateway.
TACC_SDK_READ_TIMEOUT=60
# Optional comma-separated nodes known to have insufficient GPU memory.
TACC_EXCLUDE_NODES=

# Independent OpenAI-compatible API route; course assessment still uses TACC.
# LLM_BASE_URL is the provider API base (often ending in /v1).
# API mode uses LLM_* settings; the TACC SDK route remains separately configured.
LLM_API_KEY=
LLM_BASE_URL=
MODEL_NAME=
LLM_TEMPERATURE=0

AGENT_TOOLS=web_search,read_webpage,list_contracts,read_contract,review_contract,list_skills,save_skill,create_document
AGENT_SHORT_TERM_MEMORY=1
# Frontend build settings. Never put keys in VITE_*.
VITE_API_TARGET=http://127.0.0.1:8765
VITE_PERSIST_CHAT=1

# Optional public search. Empty uses Bing RSS with limited search quality.
BRAVE_SEARCH_KEY=
# Reserved alternative providers; local Ollama embeddings and FAISS are implemented above.
SERPAPI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
VECTOR_STORE_PATH=data/vector_store
VECTOR_PERSIST=0

# Non-demo account bootstrap: set before the first APP_DEMO=0 launch.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_EMAIL_DOMAINS=
# Optional dedicated Outlook mailbox through Microsoft Graph.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_REFRESH_TOKEN=
GRAPH_POLL=20

# Mail provider: gmail or outlook. MAIL_DEMO=1 keeps all mail local.
MAIL_PROVIDER=gmail
MAIL_DEMO=1
GMAIL_MAILBOX=
# Optional HTTPS CONNECT proxy for Gmail API only; blank uses system defaults.
GMAIL_HTTPS_PROXY=

# Gmail without Cloud: imap + Google application password (not login password).
GMAIL_TRANSPORT=imap
GMAIL_APP_PASSWORD=
MAIL_POLL_SECONDS=60
# Automatically review registered senders with the standard checklist.
MAIL_AUTO_REVIEW=0

GMAIL_SMTP_PORT=587

# Independent OpenAI-compatible API route: MODEL_MODE=api; TACC stays configured separately.
LLM_CONTEXT_LIMIT=65536
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TIMEOUT=90
