# Copy to .env. Blank secret fields are intentional; never commit .env.
# Local process demo only. Course assessment must use MODEL_MODE=tacc.
APP_DATA=data
APP_PUBLIC_URL=http://127.0.0.1:8765
APP_DEMO=1
APP_SECURE_COOKIE=0
MODEL_MODE=demo

# Course TACC: set MODEL_MODE=tacc, TACC_PROTOCOL=sdk,
# TACC_MODEL=qwen3.8-27b after authenticating the official SDK.
TACC_PROTOCOL=chat
TACC_URL=
TACC_API_KEY=
TACC_MODEL=
TACC_TIMEOUT=90
TACC_CONTEXT_LIMIT=16384
TACC_JSON_MODE=0
TACC_MAX_OUTPUT_TOKENS=1800
TACC_POLL_URL=
TACC_DISABLE_THINKING=0
TACC_SDK_TIMEOUT=720

# Optional OpenAI-compatible HTTP aliases, not a replacement for required TACC.
# LLM_BASE_URL ends in /v1; TACC_URL is the FULL /v1/chat/completions URL.
# TACC_* values take precedence when set. Leave blank for the SDK route.
LLM_API_KEY=
LLM_BASE_URL=
MODEL_NAME=
LLM_TEMPERATURE=0

AGENT_TOOLS=web_search,read_webpage,list_contracts,read_contract,review_contract,list_skills,save_skill,create_document
AGENT_SHORT_TERM_MEMORY=1
# Frontend build settings. Never put keys in VITE_*.
VITE_API_TARGET=http://127.0.0.1:8765
VITE_PERSIST_CHAT=1

# Optional public search. Empty uses Bing RSS with limited search quality.
BRAVE_SEARCH_KEY=
# Reserved only: no SerpAPI, embedding or vector backend is implemented.
SERPAPI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
VECTOR_STORE_PATH=data/vector_store
VECTOR_PERSIST=0

# Non-demo account bootstrap: set before the first APP_DEMO=0 launch.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_EMAIL_DOMAINS=
# Optional dedicated Outlook mailbox through Microsoft Graph.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_REFRESH_TOKEN=
GRAPH_POLL=20
